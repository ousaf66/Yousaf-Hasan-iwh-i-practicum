doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Pets List

    // Link to add a new pet
    a(href="/pets/create") Create New Pet
    br
    br

    // Table to list all pets
    table(border="1" cellpadding="5")
      tr
        th Pet Name
        th Pet Type
        th Actions
      each pet in data
        tr
          td #{pet.properties && pet.properties.pet_name ? pet.properties.pet_name : 'N/A'}
          td #{pet.properties && pet.properties.pet_type ? pet.properties.pet_type : 'N/A'}
          td
            // Edit link
            a(href=`/pets/edit/${pet.id}`) Edit
            // Delete form
            form(action=`/pets/delete/${pet.id}` method="POST" style="display:inline; margin-left:5px;")
              button(type="submit" onclick="return confirm('Are you sure?')") Delete
