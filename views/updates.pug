doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Add a New Pet

    a(href="/") Return to the homepage
    br
    br

    form(action="/update-cobj" method="POST")
      label(for="pet_name") Name:
      input(type="text" name="pet_name" required)
      br
      label(for="pet_type") Type:
      input(type="text" name="pet_type" required)
      br
      button(type="submit") Add Pet
